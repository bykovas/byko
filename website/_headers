# Raw data sources duplicate the rendered pages — keep them out of search.
# (docs like /ext/docs/specification.pdf stay indexable on purpose: the PDF
# is the signed, versioned document, not a duplicate of the page.)

/content/*
  X-Robots-Tag: noindex

/data/*
  X-Robots-Tag: noindex

# app227 (the Farcaster mini-app on its own domain) reads the claims feed
# cross-origin. Public read-only data; the header is scoped to this one file.
/data/claims.json
  Access-Control-Allow-Origin: *

# Private wallet view: nothing links to it and it stays out of search.
/w
  X-Robots-Tag: noindex, nofollow
/w.html
  X-Robots-Tag: noindex, nofollow

# X failed to fetch the dynamic Worker image even though Facebook accepts it.
# These content-hashed PNGs are immutable, static and support byte ranges.
/assets/og/diary/*
  Cache-Control: public, max-age=31536000, immutable
