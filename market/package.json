{
  "name": "byko-market",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy": "tsc --noEmit && wrangler deploy",
    "dev": "wrangler dev",
    "schema": "wrangler d1 execute byko-market --remote --file=src/db/schema.sql",
    "hash-rules": "node scripts/hash-rules.mjs",
    "export": "node scripts/export.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.70.0",
    "viem": "^2.55.18"
  }
}
